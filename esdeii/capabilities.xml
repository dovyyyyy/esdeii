<!-- Theme capabilities for esdeii -->
<themeCapabilities>
    <themeName>esdeii</themeName>

    <aspectRatio>16:9</aspectRatio>
    <aspectRatio>16:10</aspectRatio>
    <aspectRatio>3:2</aspectRatio>
    <aspectRatio>4:3</aspectRatio>
    <aspectRatio>5:3</aspectRatio>
    <aspectRatio>5:4</aspectRatio>
    <aspectRatio>8:7</aspectRatio>
    <aspectRatio>19.5:9</aspectRatio>
    <aspectRatio>20:9</aspectRatio>
    <aspectRatio>21:9</aspectRatio>

    <fontSize>medium</fontSize>
    <fontSize>small</fontSize>
    <fontSize>large</fontSize>

    <colorScheme name="silverMenu">
        <label>Silver Menu</label>
    </colorScheme>
    <colorScheme name="cloudWhite">
        <label>Cloud White</label>
    </colorScheme>
    <colorScheme name="iceWhite">
        <label>Ice White</label>
    </colorScheme>
    <colorScheme name="cosmoBlack">
        <label>Cosmo Black</label>
    </colorScheme>
    <colorScheme name="flameRed">
        <label>Flame Red</label>
    </colorScheme>
    <colorScheme name="aquaBlue">
        <label>Aqua Blue</label>
    </colorScheme>
    <colorScheme name="mintGreen">
        <label>Mint Green</label>
    </colorScheme>
    <colorScheme name="lavender">
        <label>Lavender</label>
    </colorScheme>
    <colorScheme name="sunset">
        <label>Sunset Orange</label>
    </colorScheme>
    <colorScheme name="sakura">
        <label>Sakura Pink</label>
    </colorScheme>
    <colorScheme name="midnight">
        <label>Midnight Blue</label>
    </colorScheme>
    <colorScheme name="retroPocket">
        <label>Retro Pocket</label>
    </colorScheme>
    <colorScheme name="lightSystem">
        <label>Light + system colours</label>
    </colorScheme>
    <colorScheme name="darkSystem">
        <label>Dark + system colours</label>
    </colorScheme>

    <transitions name="esdeiiSlide">
        <label>Slide</label>
        <systemToSystem>instant</systemToSystem>
        <gamelistToGamelist>instant</gamelistToGamelist>
        <systemToGamelist>slide</systemToGamelist>
        <gamelistToSystem>slide</gamelistToSystem>
        <startupToSystem>fade</startupToSystem>
        <startupToGamelist>fade</startupToGamelist>
    </transitions>
    <transitions name="esdeiiFade">
        <label>Fade</label>
        <systemToSystem>instant</systemToSystem>
        <gamelistToGamelist>instant</gamelistToGamelist>
        <systemToGamelist>fade</systemToGamelist>
        <gamelistToSystem>fade</gamelistToSystem>
        <startupToSystem>fade</startupToSystem>
        <startupToGamelist>fade</startupToGamelist>
    </transitions>
    <transitions name="esdeiiInstant">
        <label>Instant</label>
        <systemToSystem>instant</systemToSystem>
        <gamelistToGamelist>instant</gamelistToGamelist>
        <systemToGamelist>instant</systemToGamelist>
        <gamelistToSystem>instant</gamelistToSystem>
    </transitions>

    <variant name="channelwideGrid">
        <label>Channel wall + icon grid</label>
        <selectable>true</selectable>
    </variant>
    <variant name="channelwideList">
        <label>Channel wall + game list</label>
        <selectable>true</selectable>
    </variant>
    <variant name="channelwideShelf">
        <label>Channel wall + cover shelf</label>
        <selectable>true</selectable>
    </variant>
    <variant name="plazaGrid">
        <label>Home screen + icon grid</label>
        <selectable>true</selectable>
    </variant>
    <variant name="plazaList">
        <label>Home screen + game list</label>
        <selectable>true</selectable>
    </variant>
    <variant name="plazaShelf">
        <label>Home screen + cover shelf</label>
        <selectable>true</selectable>
    </variant>
    <variant name="glossyGrid">
        <label>Home screen, glossy icons + icon grid</label>
        <selectable>true</selectable>
    </variant>
    <variant name="glossyList">
        <label>Home screen, glossy icons + game list</label>
        <selectable>true</selectable>
    </variant>
    <variant name="glossyShelf">
        <label>Home screen, glossy icons + cover shelf</label>
        <selectable>true</selectable>
    </variant>
</themeCapabilities>
