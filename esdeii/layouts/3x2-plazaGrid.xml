<!-- esdeii layout: 3:2, plazaGrid (generated by tools/build.py) -->
<theme>
    <view name="system">
        <image name="background">
            <pos>0 0</pos>
            <size>1 1</size>
            <path>./../assets/images/bg-wiiu.png</path>
            <tile>true</tile>
            <tileSize>0 0.11</tileSize>
            <color>${bgColor}</color>
            <stationary>always</stationary>
            <zIndex>0</zIndex>
        </image>
        <image name="backgroundOverlay">
            <pos>0 0</pos>
            <size>1 1</size>
            <path>./../assets/images/wiiu-swirl.png</path>
            <stationary>always</stationary>
            <opacity>${overlayOpacity}</opacity>
            <zIndex>1</zIndex>
        </image>
        <animation name="bubbles">
            <pos>0 0</pos>
            <size>1 1</size>
            <path>./../assets/images/bubbles.json</path>
            <color>${accentColor}</color>
            <opacity>${bubbleOpacity}</opacity>
            <scaleFactor>0.5</scaleFactor>
            <stationary>always</stationary>
            <zIndex>2</zIndex>
        </animation>
        <gameselector name="featured">
            <selection>random</selection>
            <gameCount>1</gameCount>
        </gameselector>
        <image name="userSlot">
            <pos>0.0333 0.03</pos>
            <size>0.1133 0.17</size>
            <path>./../assets/images/slot-square.png</path>
            <zIndex>10</zIndex>
        </image>
        <image name="userCover">
            <pos>0.09 0.115</pos>
            <origin>0.5 0.5</origin>
            <maxSize>0.0771 0.1156</maxSize>
            <imageType>cover, miximage</imageType>
            <gameselector>featured</gameselector>
            <default>./../assets/images/nocover.png</default>
            <cornerRadius>0.004</cornerRadius>
            <zIndex>11</zIndex>
        </image>
        <text name="systemName">
            <pos>0.1667 0.045</pos>
            <size>0.6 0.06</size>
            <fontPath>./../assets/fonts/Nunito-Black.ttf</fontPath>
            <fontSize>${fsWiiHeader}</fontSize>
            <color>${textColor}</color>
            <zIndex>40</zIndex>
            <text>${system.fullName}</text>
            <verticalAlignment>top</verticalAlignment>
            <lineSpacing>1.1</lineSpacing>
        </text>
        <text name="systemInfo">
            <pos>0.1667 0.115</pos>
            <size>0.42 0.032</size>
            <fontPath>./../assets/fonts/Nunito-ExtraBold.ttf</fontPath>
            <fontSize>${fsSmall}</fontSize>
            <color>${subColor}</color>
            <zIndex>40</zIndex>
            <text>${sysInfo}</text>
            <horizontalAlignment>left</horizontalAlignment>
        </text>
        <text name="gameCount">
            <pos>0.1747 0.152</pos>
            <size>0 0</size>
            <fontPath>./../assets/fonts/Nunito-ExtraBold.ttf</fontPath>
            <fontSize>${fsCount}</fontSize>
            <color>${accentText}</color>
            <zIndex>41</zIndex>
            <systemdata>gamecount</systemdata>
            <backgroundColor>${accentColor}</backgroundColor>
            <backgroundMargins>0.0093 0.0093</backgroundMargins>
            <backgroundCornerRadius>0.02</backgroundCornerRadius>
            <lineSpacing>1.6</lineSpacing>
