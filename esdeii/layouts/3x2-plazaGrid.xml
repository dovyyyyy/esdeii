            <origin>1 0.5</origin>
            <fontPath>./../assets/fonts/Nunito-Black.ttf</fontPath>
            <fontSize>${fsStatus}</fontSize>
            <color>${subColor}</color>
            <format>%H:%M</format>
        </clock>
        <systemstatus name="systemStatus">
            <pos>0.9667 0.1</pos>
            <origin>1 0.5</origin>
            <height>${fsStatus}</height>
            <color>${subColor}</color>
            <fontPath>./../assets/fonts/Nunito-ExtraBold.ttf</fontPath>
        </systemstatus>
        <grid name="systemgrid">
            <pos>0.0853 0.235</pos>
            <size>0.8293 0.614</size>
