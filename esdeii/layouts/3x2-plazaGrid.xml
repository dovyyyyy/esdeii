            <imageFit>contain</imageFit>
            <selectorImage>./../assets/images/select-start.png</selectorImage>
            <selectorColor>FFFFFFFF</selectorColor>
            <selectorLayer>top</selectorLayer>
            <text>${system.fullName}</text>
            <fontPath>./../assets/fonts/Nunito-Black.ttf</fontPath>
            <fontSize>0.024</fontSize>
            <textColor>FFFFFF</textColor>
            <textBackgroundColor>${accentColor}</textBackgroundColor>
            <textBackgroundCornerRadius>0.02</textBackgroundCornerRadius>
            <textRelativeScale>0.8</textRelativeScale>
            <lineSpacing>1.15</lineSpacing>
            <unfocusedItemOpacity>1</unfocusedItemOpacity>
